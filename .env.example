# Winston API Configuration
# Copy this file to .env.local and update values for your environment

# Winston Backend API URL
# Development: http://localhost:3000
# Staging: https://api.staging.winston.example.com
# Production: https://api.winston.example.com
VITE_WINSTON_API_URL=http://localhost:3000

# Optional: Enable debug logging for API calls
VITE_API_DEBUG=false
